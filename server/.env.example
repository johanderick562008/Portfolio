# Comma-separated list of sites allowed to call the endpoint (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://your-portfolio.example
# SMTP delivery (e.g. Gmail with an App Password, or any transactional provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=
CONTACT_FROM=
# Rate limit: RATE_LIMIT messages per RATE_WINDOW_SECONDS per IP
RATE_LIMIT=5
RATE_WINDOW_SECONDS=600
# Set to 1 only behind a proxy you trust to set X-Forwarded-For
TRUST_PROXY=0
